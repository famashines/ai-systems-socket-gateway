{
  "name": "ai-systems-socket-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket gateway of ai-systems",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "node node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-include='src/**' --test-coverage-exclude='src/main.ts' --test-coverage-exclude='src/**/*.io.ts' 'test/unit/**/*.test.ts'",
    "verify": "npm run check && npm run lint && npm test",
    "test:integration": "node --test --test-timeout=300000 'test/integration/**/*.test.ts'",
    "test:harness": "playwright test --config test/harness/playwright.config.ts"
  },
  "dependencies": {
    "@famashines/ai-systems-contracts": "github:famashines/ai-systems-contracts#v0.2.0",
    "@famashines/ai-systems-kit": "github:famashines/ai-systems-kit#v0.3.0",
    "@opentelemetry/api": "1.10.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "jose": "6.2.14",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "allowScripts": {
    "github:famashines/ai-systems-kit#7d9c7b83ae2fdf012ba02611518252df309bad64": true,
    "github:famashines/ai-systems-contracts#c13b03bf06f447369e18896f392e7cf66ae764e9": true,
    "protobufjs": false,
    "ssh2": false,
    "cpu-features": false
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.3"
  }
}
